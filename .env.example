# ─────────────────────────────────────────────────────────────────────────────
# CloudPulse — Example Environment Configuration
# Copy this file to .env and fill in real values before running the stack.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=CloudPulse
VERSION=1.0.0
DEBUG=false

# ── Database (PostgreSQL via asyncpg) ─────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://cloudpulse:password@postgres:5432/cloudpulse
POSTGRES_DB=cloudpulse
POSTGRES_USER=cloudpulse
POSTGRES_PASSWORD=change_me_before_production

# ── Cache (Redis) ─────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── AWS Credentials ───────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# ── Alerting — Email (SMTP) ───────────────────────────────────────────────────
ALERT_EMAIL=alerts@yourcompany.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ── Alerting — Slack ──────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# ── Metrics Collection ────────────────────────────────────────────────────────
METRICS_COLLECTION_INTERVAL=30

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Grafana (used by docker-compose) ─────────────────────────────────────────
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=change_me_grafana_password
